# ─────────────────────────────────────────────────────────────
# Variáveis do docker-compose (deploy em VPS). Copie para ".env" na
# raiz e preencha. NUNCA comite o .env real (está no .gitignore).
# ─────────────────────────────────────────────────────────────

# Banco MySQL (o serviço "db" do compose usa estes valores)
MYSQL_DATABASE=nutra
MYSQL_USER=nutra
MYSQL_PASSWORD=troque_esta_senha_forte
MYSQL_ROOT_PASSWORD=troque_esta_senha_root_forte

# Segredo do JWT — gere um valor aleatório longo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cole_aqui_um_segredo_aleatorio_longo
JWT_EXPIRA_HORAS=12

# HTTPS ativo em produção (o cookie de sessão só trafega em HTTPS)
COOKIE_SECURE=true

# Admin inicial (criado no primeiro start; depois troque a senha pelo painel/seed)
ADMIN_NOME=Vitor
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=defina_uma_senha_forte

# Tamanho máximo de upload de imagem (MB)
MAX_UPLOAD_MB=4

# ── Dados da loja (externalizados; expostos em /api/config e injetados no site) ──
STORE_NAME=Nutra Produtos Naturais
STORE_WHATSAPP=5527996600444
STORE_ADDRESS=Av. Saturnino Rangel Mauro, 1947
STORE_CITY=Vila Velha - ES
STORE_CEP=29102-036
STORE_HOURS=Seg a Sex: 9h às 18h · Sáb: 9h às 12h
INSTAGRAM_URL=https://instagram.com/nutraprodutosnaturais

# Regras do carrinho (stepper de gramas no frontend)
CART_MIN_GRAMS=100
CART_STEP_GRAMS=50
CART_MAX_GRAMS=5000
