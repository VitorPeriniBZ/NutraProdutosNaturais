# ─────────────────────────────────────────────────────────────
# Configuração da API Nutra. Copie para ".env" e ajuste os valores.
# NUNCA comite o arquivo .env real (ele está no .gitignore).
# ─────────────────────────────────────────────────────────────

# Porta HTTP da API
PORT=3000
NODE_ENV=development

# ── Banco de dados ──
# DB_CLIENT: "sqlite" (dev local, sem instalar nada) ou "mysql" (produção Hostinger)
DB_CLIENT=sqlite

# Caminho do arquivo SQLite (usado só quando DB_CLIENT=sqlite)
SQLITE_FILE=./data/nutra.db

# Credenciais MySQL/MariaDB (usadas só quando DB_CLIENT=mysql)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nutra
MYSQL_PASSWORD=troque_esta_senha
MYSQL_DATABASE=nutra

# ── Frontend estático ──
# SERVE_STATIC=true faz a própria API servir o site público e o painel admin.
SERVE_STATIC=true

# ── CORS (só se o frontend for servido em outra origem; deixe vazio no padrão) ──
CORS_ORIGIN=

# ── Autenticação do painel (Fase 2) ──
# Gere um segredo forte, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-este-segredo-por-um-aleatorio-longo
JWT_EXPIRA_HORAS=12
# COOKIE_SECURE=true exige HTTPS (deixe true em produção, false no dev local em http)
COOKIE_SECURE=false

# ── Admin inicial (criado pelo seed se não existir) ──
ADMIN_NOME=Vitor
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Uploads de imagem ──
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=4

# ── Regras globais de gramagem (fallback quando o produto não define override) ──
GRAMA_MIN=100
GRAMA_STEP=50
GRAMA_MAX=5000
