    "file-type": "^21.3.4",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.11.5"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "supertest": "^7.2.2"
  }
