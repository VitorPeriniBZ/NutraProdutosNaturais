{
  "name": "nutra-api",
  "version": "1.0.0",
  "description": "API do site Nutra Produtos Naturais (catálogo + painel admin)",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
